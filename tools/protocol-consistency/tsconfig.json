{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      // 原包（F: 盘为残缺安装，无 pnpm workspace 链接）在测试侧的解析兜底：
      // 映射到 vendor 进 node_modules 的源码副本（仅测试用，不入设备构建）。
      // zod 取自协议 HAR 自带 tarball（commons/protocol/libs/zod-4.6.5.tgz），
      // 供 E 盘完整 zcode 仓（未装依赖）的原包 shared 源解析。
      "@zcode/model-option-map": ["./node_modules/@zcode/model-option-map/src/index.ts"],
      "zod": ["./node_modules/zod/src/index.ts"]
    }
  },
  "include": ["*.mjs"]
}
